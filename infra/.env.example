# Copy to infra/.env and fill in real values. Never commit infra/.env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Europe/Rome

# --- Database (docker compose service name: db) ---
DATABASE_URL=postgres://musicstudio:musicstudio@db:5432/musicstudio
POSTGRES_DB=musicstudio
POSTGRES_USER=musicstudio
POSTGRES_PASSWORD=musicstudio

# --- Redis / Celery (docker compose service name: redis) ---
CELERY_BROKER_URL=redis://redis:6379/0

# --- JWT ---
JWT_SIGNING_KEY=change-me-too-a-different-long-random-string

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (reminders) — only used by config.settings.prod ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@musicstudio.local

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
