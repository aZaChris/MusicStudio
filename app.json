{
  "expo": {
    "name": "MusicStudio",
    "slug": "musicstudio-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "musicstudioapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.musicstudio.app",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "package": "com.musicstudio.app",
      "adaptiveIcon": {
        "backgroundColor": "#ef852e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#fcf3ee",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "114a3072-65d9-4292-b574-feddfdf6ec34"
      }
    },
    "owner": "azachris"
  }
}
