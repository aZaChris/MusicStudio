{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "test": "TZ=Europe/Rome vitest run",
    "api:types": "npx --yes openapi-typescript@7.13.0 ../backend/openapi.yaml -o src/api/schema.d.ts",
    "api:check": "npm run api:types && git diff --exit-code -- src/api/schema.d.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@tanstack/react-query": "^5.107.1",
    "i18next": "^27.0.1",
    "i18next-browser-languagedetector": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
