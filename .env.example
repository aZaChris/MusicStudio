# MusicStudio configuration. Copy to `.env` for local development (never commit `.env`).
# Every setting the backend reads is listed here. On Coolify, set the production values
# in the resource's Environment Variables; variables marked (generated) are created by
# Coolify itself from docker-compose.coolify.yml.

# --- Django ---------------------------------------------------------------------------
# dev | test | prod. Containers set this; locally manage.py defaults to dev.
DJANGO_SETTINGS_MODULE=config.settings.dev
# >= 50 random chars in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Coolify: generated as SERVICE_PASSWORD_64_DJANGOSECRET.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DJANGO_DEBUG=true
# Comma-separated. Prod default on Coolify: the backend's domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins (admin login behind TLS). Prod default: backend URL.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/
DJANGO_TIME_ZONE=Europe/Rome
# prod only: set false only if TLS is not terminated in front of the app.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000
LOG_LEVEL=INFO
# prod: JSON logs. Optional error tracking; empty = disabled, the API works without it.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# 0 = no performance traces (free tier quota); errors are always sent.
SENTRY_TRACES_SAMPLE_RATE=0
# Number of reverse proxies in front of gunicorn that append to X-Forwarded-For
# (Coolify/Traefik = 1). 0 = use the socket address (local dev). See ADR-021.
TRUSTED_PROXY_COUNT=0

# --- Database -------------------------------------------------------------------------
# Compose (dev): built from POSTGRES_* below. Coolify: built from generated credentials.
DATABASE_URL=postgres://musicstudio:musicstudio@localhost:5432/musicstudio
DB_CONN_MAX_AGE=60
POSTGRES_DB=musicstudio
POSTGRES_USER=musicstudio
POSTGRES_PASSWORD=musicstudio

# --- Redis / Celery / cache -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Optional overrides (default to REDIS_URL):
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CACHE_URL=
CELERY_CONCURRENCY=2

# --- Auth (JWT) and rate limits -------------------------------------------------------
# prod: required, >= 32 bytes. Coolify: generated as SERVICE_PASSWORD_64_JWTKEY.
JWT_SIGNING_KEY=
# Access tokens are not checked against the revocation list (ADR-018): keep them short.
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
THROTTLE_LOGIN=5/min
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour

# --- CORS (browser clients) -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (reminders). prod: SMTP_HOST/USER/PASSWORD and DEFAULT_FROM_EMAIL required --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@musicstudio.local

# --- Accounts and privacy (phase 7) --------------------------------------------------
# Fernet keys for encrypted fields (lesson notes, MFA secrets), comma-separated: the FIRST
# encrypts, all decrypt (rotation: prepend a new key, deploy, `manage.py rotate_field_keys`,
# then drop the old one). prod: REQUIRED, never the dev default. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing every key makes encrypted notes unreadable: keep a copy outside the server.
FIELD_ENCRYPTION_KEYS=
# Public URL of the web portal, used in email links. Coolify default: the `web` service URL.
FRONTEND_URL=http://localhost:5173
# Version of the privacy notice (docs/privacy/) new consents refer to.
PRIVACY_NOTICE_VERSION=2026-11-draft
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_MFA=5/min
THROTTLE_PRIVACY=10/hour
THROTTLE_INVITATION_ACCEPT=10/hour

# --- Online payments: Stripe, TEST MODE ONLY (live keys abort start-up) ---------------
# Prefer a restricted key (rk_test_...) with "Checkout Sessions: write", from a dedicated
# Stripe sandbox. Empty = online checkout answers 503, everything else works.
STRIPE_API_KEY=
# From the webhook endpoint (Dashboard) or `stripe listen` (local): whsec_...
STRIPE_WEBHOOK_SECRET=
# Comma list of Stripe webhook source IPs (https://stripe.com/files/ips/ips_webhooks.txt).
# Empty = check disabled (dev/tests); the signature is always verified anyway.
STRIPE_WEBHOOK_ALLOWED_IPS=
STRIPE_CURRENCY=eur
CHECKOUT_SUCCESS_URL=http://localhost:5173/payments/success
CHECKOUT_CANCEL_URL=http://localhost:5173/payments/cancel
CHECKOUT_TTL_MINUTES=30

# --- Cache / Celery tuning -------------------------------------------------------------
DASHBOARD_CACHE_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT=60
CELERY_TASK_TIME_LIMIT=90

# --- Web server (container) -----------------------------------------------------------
# Container port. On Coolify the domain suffix (:8000) must match.
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=30
# 1 = run migrations when the web container starts (single replica).
RUN_MIGRATIONS=1

# --- Web portal (Coolify stack) -------------------------------------------------------
# The API's public HTTPS origin, without path (e.g. https://api.example.com). Used for the
# portal's build (API base URL) and its Content-Security-Policy. Required by the `web` service.
API_PUBLIC_URL=
# Browser origins allowed to call the API. On Coolify it defaults to the `web` service URL.
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Backups: ONLY for the optional docker-compose.backup.yml overlay (ADR-026) --------
# On the Coolify server the operator backs up the database; leave these unset there.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# Off-site copy (ADR-020): rclone crypt over any S3-compatible bucket (never AWS).
RCLONE_S3_PROVIDER=Other
RCLONE_S3_ENDPOINT=
RCLONE_S3_ACCESS_KEY_ID=
RCLONE_S3_SECRET_ACCESS_KEY=
RCLONE_BUCKET=
# Two passwords for client-side encryption, obscured with `rclone obscure`. Lose them and
# the off-site backups are unreadable: store them outside the server too.
RCLONE_CRYPT_PASSWORD=
RCLONE_CRYPT_PASSWORD2=
OFFSITE_SCHEDULE_SECONDS=86400
# Remote copies older than this are deleted (longest local retention is 6 months).
OFFSITE_KEEP_DAYS=190
# Optional dead-man switch (e.g. healthchecks.io): pinged on success, /fail on failure.
BACKUP_ALERT_URL=

# --- Dev compose host ports -----------------------------------------------------------
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
