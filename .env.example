# Copy to .env.local for local dev. In prod these are provisioned automatically:
# DATABASE_URL by the Neon Vercel Marketplace integration, the rest via `vercel env add`.

# --- Database (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Auth.js ---
# Generate with: npx auth secret
AUTH_SECRET=

# --- Cron ---
# Any random string; Vercel Cron sends it back as `Authorization: Bearer <value>`.
CRON_SECRET=
