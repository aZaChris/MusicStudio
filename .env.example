# MusicStudio configuration. Copy to `.env` for local development (never commit `.env`).
# Every setting the backend reads is listed here. On Coolify, set the production values
# in the resource's Environment Variables; variables marked (generated) are created by
# Coolify itself from docker-compose.coolify.yml.

# --- Django ---------------------------------------------------------------------------
# dev | test | prod. Containers set this; locally manage.py defaults to dev.
DJANGO_SETTINGS_MODULE=config.settings.dev
# >= 50 random chars in production: python -c "import secrets; print(secrets.token_urlsafe(50))"
# Coolify: generated as SERVICE_PASSWORD_64_DJANGOSECRET.
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me-0123456789abcdef
DJANGO_DEBUG=true
# Comma-separated. Prod default on Coolify: the backend's domain.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated https origins (admin login behind TLS). Prod default: backend URL.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_URL=admin/
DJANGO_TIME_ZONE=Europe/Rome
# prod only: set false only if TLS is not terminated in front of the app.
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=2592000
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------------------
# Compose (dev): built from POSTGRES_* below. Coolify: built from generated credentials.
DATABASE_URL=postgres://musicstudio:musicstudio@localhost:5432/musicstudio
DB_CONN_MAX_AGE=60
POSTGRES_DB=musicstudio
POSTGRES_USER=musicstudio
POSTGRES_PASSWORD=musicstudio

# --- Redis / Celery / cache -----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
# Optional overrides (default to REDIS_URL):
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=
# CACHE_URL=
CELERY_CONCURRENCY=2

# --- Auth (JWT) and rate limits -------------------------------------------------------
# prod: required, >= 32 bytes. Coolify: generated as SERVICE_PASSWORD_64_JWTKEY.
JWT_SIGNING_KEY=
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14
THROTTLE_LOGIN=5/min
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour

# --- CORS (browser clients) -----------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Email (reminders). prod: SMTP_HOST/USER/PASSWORD and DEFAULT_FROM_EMAIL required --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
DEFAULT_FROM_EMAIL=noreply@musicstudio.local

# --- Web server (container) -----------------------------------------------------------
# Container port. On Coolify the domain suffix (:8000) must match.
PORT=8000
WEB_CONCURRENCY=3
GUNICORN_TIMEOUT=30
# 1 = run migrations when the web container starts (single replica).
RUN_MIGRATIONS=1

# --- Backups (Coolify stack) ----------------------------------------------------------
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Dev compose host ports -----------------------------------------------------------
DB_HOST_PORT=5432
REDIS_HOST_PORT=6379
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
